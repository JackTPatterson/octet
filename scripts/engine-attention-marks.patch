index 00000000..11e22fe1
--- /dev/null
+++ b/src/app/terminal_attention.rs
@@ -0,0 +1,232 @@
+//! Publishes terminal attention requests (BEL, OSC 9 / OSC 777 desktop
+//! notifications) as API events. Herdr's own bell forwarding and agent
+//! notification policy are unchanged; this only feeds the event history that
+//! `events.subscribe` replays.
+
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+use crate::events::AppEvent;
+use crate::layout::PaneId;
+
+use super::App;
+
+/// Bells are an attention signal, so bursts within this window collapse into
+/// one event. This keeps a program spamming BEL from evicting other events
+/// from the bounded API history.
+const BELL_WINDOW: Duration = Duration::from_millis(250);
+/// Desktop notifications carry distinct text, so allow a small burst per
+/// window instead of collapsing them.
+const NOTIFICATION_WINDOW: Duration = Duration::from_secs(1);
+const NOTIFICATIONS_PER_WINDOW: u32 = 10;
+const MAX_TRACKED_PANES: usize = 256;
+
+#[derive(Debug, Default)]
+pub(crate) struct TerminalAttentionLimiter {
+    panes: HashMap<PaneId, PaneAttentionWindow>,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct PaneAttentionWindow {
+    last_bell: Option<Instant>,
+    notification_window_start: Option<Instant>,
+    notifications_in_window: u32,
+}
+
+impl TerminalAttentionLimiter {
+    pub(crate) fn allow_bell(&mut self, pane_id: PaneId, now: Instant) -> bool {
+        let window = self.window(pane_id, now);
+        if window
+            .last_bell
+            .is_some_and(|last| now.saturating_duration_since(last) < BELL_WINDOW)
+        {
+            return false;
+        }
+        window.last_bell = Some(now);
+        true
+    }
+
+    pub(crate) fn allow_notification(&mut self, pane_id: PaneId, now: Instant) -> bool {
+        let window = self.window(pane_id, now);
+        let expired = window
+            .notification_window_start
+            .is_none_or(|start| now.saturating_duration_since(start) >= NOTIFICATION_WINDOW);
+        if expired {
+            window.notification_window_start = Some(now);
+            window.notifications_in_window = 0;
+        }
+        if window.notifications_in_window >= NOTIFICATIONS_PER_WINDOW {
+            return false;
+        }
+        window.notifications_in_window += 1;
+        true
+    }
+
+    fn window(&mut self, pane_id: PaneId, now: Instant) -> &mut PaneAttentionWindow {
+        if self.panes.len() >= MAX_TRACKED_PANES && !self.panes.contains_key(&pane_id) {
+            let horizon = BELL_WINDOW.max(NOTIFICATION_WINDOW);
+            self.panes.retain(|_, window| {
+                window
+                    .last_bell
+                    .into_iter()
+                    .chain(window.notification_window_start)
+                    .any(|at| now.saturating_duration_since(at) < horizon)
+            });
+        }
+        self.panes.entry(pane_id).or_insert(PaneAttentionWindow {
+            last_bell: None,
+            notification_window_start: None,
+            notifications_in_window: 0,
+        })
+    }
+}
+
+impl App {
+    pub(crate) fn emit_terminal_attention(&mut self, event: &AppEvent, now: Instant) {
+        use crate::api::schema::{EventData, EventEnvelope, EventKind};
+
+        let (pane_id, envelope) = match event {
+            AppEvent::TerminalBell { pane_id, count } if *count > 0 => {
+                (*pane_id, EventKind::PaneBell)
+            }
+            AppEvent::TerminalDesktopNotification { pane_id, .. } => {
+                (*pane_id, EventKind::PaneNotification)
+            }
+            _ => return,
+        };
+        let Some((ws_idx, _)) = self.find_pane(pane_id) else {
+            return;
+        };
+        let Some(public_pane_id) = self.public_pane_id(ws_idx, pane_id) else {
+            return;
+        };
+        let workspace_id = self.public_workspace_id(ws_idx);
+        let allowed = match envelope {
+            EventKind::PaneBell => self.terminal_attention_limiter.allow_bell(pane_id, now),
+            _ => self
+                .terminal_attention_limiter
+                .allow_notification(pane_id, now),
+        };
+        if !allowed {
+            return;
+        }
+        let data = match event {
+            AppEvent::TerminalDesktopNotification { title, body, .. } => {
+                EventData::PaneNotification {
+                    pane_id: public_pane_id,
+                    workspace_id,
+                    title: title.clone(),
+                    body: body.clone(),
+                }
+            }
+            _ => EventData::PaneBell {
+                pane_id: public_pane_id,
+                workspace_id,
+            },
+        };
+        // Attention events are not plugin hook events; push without hooks.
+        self.event_hub.push(EventEnvelope {
+            event: envelope,
+            data,
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::api::schema::{EventData, EventKind};
+    use crate::config::Config;
+    use crate::workspace::Workspace;
+
+    #[test]
+    fn bell_bursts_collapse_per_pane() {
+        let mut limiter = TerminalAttentionLimiter::default();
+        let start = Instant::now();
+        let pane = PaneId::from_raw(1);
+        let other = PaneId::from_raw(2);
+
+        assert!(limiter.allow_bell(pane, start));
+        assert!(!limiter.allow_bell(pane, start + Duration::from_millis(10)));
+        assert!(limiter.allow_bell(other, start + Duration::from_millis(10)));
+        assert!(limiter.allow_bell(pane, start + BELL_WINDOW));
+    }
+
+    #[test]
+    fn notifications_allow_a_bounded_burst() {
+        let mut limiter = TerminalAttentionLimiter::default();
+        let start = Instant::now();
+        let pane = PaneId::from_raw(1);
+
+        for _ in 0..NOTIFICATIONS_PER_WINDOW {
+            assert!(limiter.allow_notification(pane, start));
+        }
+        assert!(!limiter.allow_notification(pane, start + Duration::from_millis(500)));
+        assert!(limiter.allow_notification(pane, start + NOTIFICATION_WINDOW));
+    }
+
+    #[test]
+    fn terminal_attention_events_reach_api_history_with_public_ids() {
+        let event_hub = crate::api::EventHub::default();
+        let (_api_tx, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = App::new(
+            &Config::default(),
+            crate::app::AppPolicy::TEST,
+            None,
+            api_rx,
+            event_hub.clone(),
+        );
+        app.state.workspaces = vec![Workspace::test_new("one")];
+        let pane_id = app.state.workspaces[0].focused_pane_id().unwrap();
+        let public_pane_id = app.public_pane_id(0, pane_id).unwrap();
+        let workspace_id = app.public_workspace_id(0);
+        let now = Instant::now();
+
+        app.emit_terminal_attention(&AppEvent::TerminalBell { pane_id, count: 3 }, now);
+        // Collapsed into the first bell.
+        app.emit_terminal_attention(
+            &AppEvent::TerminalBell { pane_id, count: 1 },
+            now + Duration::from_millis(1),
+        );
+        app.emit_terminal_attention(
+            &AppEvent::TerminalDesktopNotification {
+                pane_id,
+                title: None,
+                body: "done".into(),
+            },
+            now,
+        );
+        // Unknown panes are ignored.
+        app.emit_terminal_attention(
+            &AppEvent::TerminalBell {
+                pane_id: crate::layout::PaneId::from_raw(9999),
+                count: 1,
+            },
+            now + Duration::from_secs(5),
+        );
+
+        let events: Vec<_> = event_hub
+            .events_after(0)
+            .into_iter()
+            .map(|(_, event)| event)
+            .collect();
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[0].event, EventKind::PaneBell);
+        assert_eq!(
+            events[0].data,
+            EventData::PaneBell {
+                pane_id: public_pane_id.clone(),
+                workspace_id: workspace_id.clone(),
+            }
+        );
+        assert_eq!(
+            events[1].data,
+            EventData::PaneNotification {
+                pane_id: public_pane_id,
+                workspace_id,
+                title: None,
+                body: "done".into(),
+            }
+        );
+    }
+}
