@@ -0,0 +1,137 @@
+//! Tracked grid references and semantic-content reads used for shell prompt
+//! marks. A tracked reference follows its cell through scrolling, scrollback
+//! pruning, and resize reflow, so positions recorded when a mark arrived stay
+//! exact without re-scanning the screen.
+
+use std::ptr;
+
+use super::{ffi, ghostty_screen_point, grid_ref_graphemes, grid_ref_wrap_state, Terminal};
+
+pub(crate) struct TrackedGridRef {
+    raw: ffi::GhosttyTrackedGridRef,
+}
+
+// SAFETY: the handle is only used behind the pane core mutex, like Terminal.
+unsafe impl Send for TrackedGridRef {}
+
+impl TrackedGridRef {
+    /// Current position in screen coordinates (row 0 is the oldest retained
+    /// scrollback row), or `None` once the referenced row has been pruned,
+    /// erased, or the owning terminal was freed.
+    pub(crate) fn screen_point(&self) -> Option<(u16, u32)> {
+        let mut point = ffi::GhosttyPointCoordinate::default();
+        // SAFETY: raw is a live tracked reference owned by self.
+        let result = unsafe {
+            ffi::ghostty_tracked_grid_ref_point(
+                self.raw,
+                ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_SCREEN,
+                &mut point,
+            )
+        };
+        (result == ffi::GhosttyResult_GHOSTTY_SUCCESS).then_some((point.x, point.y))
+    }
+}
+
+impl Drop for TrackedGridRef {
+    fn drop(&mut self) {
+        // SAFETY: freeing is valid even after the owning terminal was freed.
+        unsafe { ffi::ghostty_tracked_grid_ref_free(self.raw) }
+    }
+}
+
+impl std::fmt::Debug for TrackedGridRef {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("TrackedGridRef")
+            .field(&self.screen_point())
+            .finish()
+    }
+}
+
+impl Terminal {
+    /// Tracks the cell under the cursor on the active screen.
+    pub(crate) fn track_cursor(&self) -> Option<TrackedGridRef> {
+        let x = self
+            .get_u16(ffi::GhosttyTerminalData_GHOSTTY_TERMINAL_DATA_CURSOR_X)
+            .ok()?;
+        let y = self.cursor_y().ok()?;
+        let point = ffi::GhosttyPoint {
+            tag: ffi::GhosttyPointTag_GHOSTTY_POINT_TAG_ACTIVE,
+            value: ffi::GhosttyPointValue {
+                coordinate: ffi::GhosttyPointCoordinate { x, y: u32::from(y) },
+            },
+        };
+        let mut raw = ptr::null_mut();
+        // SAFETY: self.raw is live and raw is a valid out pointer.
+        let result = unsafe { ffi::ghostty_terminal_grid_ref_track(self.raw, point, &mut raw) };
+        (result == ffi::GhosttyResult_GHOSTTY_SUCCESS && !raw.is_null())
+            .then_some(TrackedGridRef { raw })
+    }
+
+    /// Text of the cells marked as shell input (OSC 133 B..C) between `start`
+    /// (inclusive) and `end` (exclusive), in screen coordinates. Prompt cells
+    /// on the same rows, such as a right prompt, are skipped. Hard line breaks
+    /// become `\n`; soft wraps are joined.
+    pub(crate) fn semantic_input_text(
+        &self,
+        start: (u16, u32),
+        end: (u16, u32),
+        max_rows: u32,
+    ) -> Option<String> {
+        if (end.1, end.0) <= (start.1, start.0) {
+            return None;
+        }
+        let cols = self.cols().ok()?;
+        let last_row = end.1.min(start.1.saturating_add(max_rows));
+        let mut text = String::new();
+        for y in start.1..=last_row {
+            let first_x = if y == start.1 { start.0 } else { 0 };
+            let end_x = if y == end.1 { end.0 } else { cols };
+            if first_x >= end_x {
+                continue;
+            }
+            let mut grid_ref = self.grid_ref(ghostty_screen_point(0, y)).ok()?;
+            let (soft_wrapped, _) = grid_ref_wrap_state(&grid_ref).ok()?;
+            let mut line = String::new();
+            for x in first_x..end_x {
+                grid_ref.x = x;
+                if !grid_ref_is_input(&grid_ref) {
+                    continue;
+                }
+                let graphemes = grid_ref_graphemes(&grid_ref).ok()?;
+                if graphemes.is_empty() {
+                    line.push(' ');
+                }
+                line.extend(graphemes.into_iter().filter_map(char::from_u32));
+            }
+            if soft_wrapped && y != end.1 {
+                text.push_str(&line);
+            } else {
+                text.push_str(line.trim_end());
+                text.push('\n');
+            }
+        }
+        let text = text.trim().to_string();
+        (!text.is_empty()).then_some(text)
+    }
+}
+
+fn grid_ref_is_input(grid_ref: &ffi::GhosttyGridRef) -> bool {
+    let mut cell = ffi::GhosttyCell::default();
+    let mut content = ffi::GhosttyCellSemanticContent_GHOSTTY_CELL_SEMANTIC_OUTPUT;
+    // SAFETY: grid_ref is a fresh untracked reference and the out pointers match
+    // the requested data types.
+    unsafe {
+        if ffi::ghostty_grid_ref_cell(grid_ref, &mut cell) != ffi::GhosttyResult_GHOSTTY_SUCCESS {
+            return false;
+        }
+        if ffi::ghostty_cell_get(
+            cell,
+            ffi::GhosttyCellData_GHOSTTY_CELL_DATA_SEMANTIC_CONTENT,
+            (&mut content as *mut ffi::GhosttyCellSemanticContent).cast(),
+        ) != ffi::GhosttyResult_GHOSTTY_SUCCESS
+        {
+            return false;
+        }
+    }
+    content == ffi::GhosttyCellSemanticContent_GHOSTTY_CELL_SEMANTIC_INPUT
+}
