+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scrollbar_renders_only_a_capped_thumb() {
+        let track = Rect::new(2, 0, 1, 8);
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 4, 8));
+        let metrics = crate::pane::ScrollMetrics {
+            offset_from_bottom: 0,
+            max_offset_from_bottom: 8,
+            viewport_rows: 8,
+        };
+
+        render_scrollbar_buffer(
+            &mut buffer,
+            metrics,
+            track,
+            Color::DarkGray,
+            Color::White,
+            "▐",
+        );
+
+        let painted: Vec<_> = (track.y..track.bottom())
+            .filter_map(|y| {
+                let symbol = buffer[(track.x, y)].symbol();
+                (symbol != " ").then_some((y, symbol.to_owned()))
+            })
+            .collect();
+        assert_eq!(painted, vec![(4, "╻".into()), (5, "┃".into()), (6, "┃".into()), (7, "╹".into())]);
+    }
+}
