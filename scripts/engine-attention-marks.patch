@@ -0,0 +1,457 @@
+//! Shell command history from OSC 133 semantic prompt marks.
+//!
+//! libghostty-vt applies OSC 133 to cell semantic content but does not expose
+//! the marks themselves, exit codes, or timing. This tracker observes the
+//! sequences in the PTY stream, and after libghostty-vt has processed each one
+//! pins the cursor cell with a tracked grid reference. Tracked references
+//! follow their rows through scrolling, scrollback pruning, and reflow, so the
+//! reported rows are exact screen coordinates at read time.
+
+use std::collections::VecDeque;
+
+use crate::ghostty::{Terminal, TrackedGridRef};
+
+use super::osc::OscStreamCollector;
+
+/// Bounds retained commands per pane; each holds up to four tracked refs.
+const MAX_COMMANDS: usize = 256;
+/// Bounds the rows scanned when reading a command line's input text.
+const MAX_COMMAND_ROWS: u32 = 64;
+const MAX_COMMAND_CHARS: usize = 4096;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum PromptMarkKind {
+    /// OSC 133;A or 133;N.
+    PromptStart,
+    /// OSC 133;B.
+    InputStart,
+    /// OSC 133;C.
+    OutputStart,
+    /// OSC 133;D[;exit_code].
+    CommandFinished { exit_code: Option<i32> },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) struct PromptMarkEvent {
+    /// Offset just past the sequence terminator in the observed chunk.
+    pub(super) end_offset: usize,
+    pub(super) kind: PromptMarkKind,
+}
+
+pub(super) fn parse_prompt_mark(body: &[u8]) -> Option<PromptMarkKind> {
+    let rest = body.strip_prefix(b"133;")?;
+    let mut params = rest.split(|&byte| byte == b';');
+    let action = params.next()?;
+    match action {
+        b"A" | b"N" => {
+            // Continuation prompts (k=c / k=s) belong to the current command.
+            let continuation = params.any(|param| matches!(param, b"k=c" | b"k=s"));
+            (!continuation).then_some(PromptMarkKind::PromptStart)
+        }
+        b"B" => Some(PromptMarkKind::InputStart),
+        b"C" => Some(PromptMarkKind::OutputStart),
+        b"D" => {
+            let exit_code = params
+                .next()
+                .and_then(|param| std::str::from_utf8(param).ok())
+                .and_then(|param| param.trim().parse::<i32>().ok());
+            Some(PromptMarkKind::CommandFinished { exit_code })
+        }
+        _ => None,
+    }
+}
+
+#[derive(Debug)]
+struct CommandRecord {
+    prompt: TrackedGridRef,
+    input: Option<TrackedGridRef>,
+    output: Option<TrackedGridRef>,
+    end: Option<TrackedGridRef>,
+    exit_code: Option<i32>,
+    started_at_ms: Option<u64>,
+    finished_at_ms: Option<u64>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PromptMarkSnapshot {
+    pub prompt_row: u64,
+    pub output_row: Option<u64>,
+    pub end_row: Option<u64>,
+    pub exit_code: Option<i32>,
+    pub started_at_ms: Option<u64>,
+    pub finished_at_ms: Option<u64>,
+    pub command: Option<String>,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct PromptMarkTracker {
+    collector: OscStreamCollector,
+    pending: Vec<PromptMarkEvent>,
+    commands: VecDeque<CommandRecord>,
+}
+
+impl PromptMarkTracker {
+    pub(super) fn observe(&mut self, bytes: &[u8]) {
+        let pending = &mut self.pending;
+        self.collector
+            .observe_with_offsets(bytes, |body, end_offset| {
+                if let Some(kind) = parse_prompt_mark(body) {
+                    pending.push(PromptMarkEvent { end_offset, kind });
+                }
+            });
+    }
+
+    pub(super) fn drain_pending(&mut self) -> Vec<PromptMarkEvent> {
+        std::mem::take(&mut self.pending)
+    }
+
+    /// Records a mark at the terminal cursor. Call after libghostty-vt has
+    /// processed every byte up to and including the mark's sequence.
+    pub(super) fn apply(&mut self, terminal: &Terminal, kind: PromptMarkKind, now_ms: u64) {
+        if matches!(
+            terminal.active_screen(),
+            Ok(crate::ghostty::ActiveScreen::Alternate)
+        ) {
+            return;
+        }
+        let Some(here) = terminal.track_cursor() else {
+            return;
+        };
+        match kind {
+            PromptMarkKind::PromptStart => {
+                // Shells redraw the prompt in place (resize, reset-prompt);
+                // a fresh A on the same row replaces an untouched prompt.
+                let redraw = self.commands.back().is_some_and(|last| {
+                    last.input.is_none()
+                        && last.output.is_none()
+                        && last.end.is_none()
+                        && row(&last.prompt).is_some()
+                        && row(&last.prompt) == row(&here)
+                });
+                if redraw {
+                    self.commands.pop_back();
+                }
+                self.commands.push_back(CommandRecord {
+                    prompt: here,
+                    input: None,
+                    output: None,
+                    end: None,
+                    exit_code: None,
+                    started_at_ms: None,
+                    finished_at_ms: None,
+                });
+                while self.commands.len() > MAX_COMMANDS {
+                    self.commands.pop_front();
+                }
+            }
+            PromptMarkKind::InputStart => {
+                if let Some(last) = self
+                    .commands
+                    .back_mut()
+                    .filter(|last| last.output.is_none() && last.end.is_none())
+                {
+                    last.input = Some(here);
+                }
+            }
+            PromptMarkKind::OutputStart => {
+                if let Some(last) = self
+                    .commands
+                    .back_mut()
+                    .filter(|last| last.output.is_none() && last.end.is_none())
+                {
+                    last.output = Some(here);
+                    last.started_at_ms = Some(now_ms);
+                }
+            }
+            PromptMarkKind::CommandFinished { exit_code } => {
+                if let Some(last) = self.commands.back_mut().filter(|last| last.end.is_none()) {
+                    last.end = Some(here);
+                    last.exit_code = exit_code;
+                    last.finished_at_ms = Some(now_ms);
+                }
+            }
+        }
+    }
+
+    /// Returns up to `limit` most recent commands, oldest first. Commands
+    /// whose prompt row left the retained scrollback are forgotten.
+    pub(crate) fn snapshot(
+        &mut self,
+        terminal: &Terminal,
+        limit: usize,
+    ) -> Vec<PromptMarkSnapshot> {
+        self.commands
+            .retain(|command| command.prompt.screen_point().is_some());
+        let skip = self.commands.len().saturating_sub(limit);
+        self.commands
+            .iter()
+            .skip(skip)
+            .filter_map(|command| {
+                let (_, prompt_row) = command.prompt.screen_point()?;
+                let output = command
+                    .output
+                    .as_ref()
+                    .and_then(TrackedGridRef::screen_point);
+                let input = command
+                    .input
+                    .as_ref()
+                    .and_then(TrackedGridRef::screen_point);
+                let text = match (input, output) {
+                    (Some(input), Some(output)) => terminal
+                        .semantic_input_text(input, output, MAX_COMMAND_ROWS)
+                        .map(|text| text.chars().take(MAX_COMMAND_CHARS).collect()),
+                    _ => None,
+                };
+                Some(PromptMarkSnapshot {
+                    prompt_row: u64::from(prompt_row),
+                    output_row: output.map(|(_, y)| u64::from(y)),
+                    end_row: command.end.as_ref().and_then(row).map(u64::from),
+                    exit_code: command.exit_code,
+                    started_at_ms: command.started_at_ms,
+                    finished_at_ms: command.finished_at_ms,
+                    command: text,
+                })
+            })
+            .collect()
+    }
+}
+
+fn row(tracked: &TrackedGridRef) -> Option<u32> {
+    tracked.screen_point().map(|(_, y)| y)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_semantic_prompt_actions() {
+        assert_eq!(
+            parse_prompt_mark(b"133;A"),
+            Some(PromptMarkKind::PromptStart)
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;A;aid=1;cl=m"),
+            Some(PromptMarkKind::PromptStart)
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;N"),
+            Some(PromptMarkKind::PromptStart)
+        );
+        assert_eq!(parse_prompt_mark(b"133;A;k=s"), None);
+        assert_eq!(
+            parse_prompt_mark(b"133;B"),
+            Some(PromptMarkKind::InputStart)
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;C;cmdline_url=ls"),
+            Some(PromptMarkKind::OutputStart)
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;D;2"),
+            Some(PromptMarkKind::CommandFinished { exit_code: Some(2) })
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;D"),
+            Some(PromptMarkKind::CommandFinished { exit_code: None })
+        );
+        assert_eq!(
+            parse_prompt_mark(b"133;D;;aid=1"),
+            Some(PromptMarkKind::CommandFinished { exit_code: None })
+        );
+        assert_eq!(parse_prompt_mark(b"133;P;k=i"), None);
+        assert_eq!(parse_prompt_mark(b"1337;A"), None);
+        assert_eq!(parse_prompt_mark(b"9;hello"), None);
+    }
+
+    struct Pane {
+        pane: super::super::terminal::GhosttyPaneTerminal,
+        tx: tokio::sync::mpsc::Sender<bytes::Bytes>,
+    }
+
+    impl Pane {
+        fn new(cols: u16, rows: u16, max_scrollback_bytes: usize) -> Self {
+            let (tx, _rx) = tokio::sync::mpsc::channel(4);
+            let terminal = crate::ghostty::Terminal::new(cols, rows, max_scrollback_bytes).unwrap();
+            let pane =
+                super::super::terminal::GhosttyPaneTerminal::new(terminal, tx.clone()).unwrap();
+            Self { pane, tx }
+        }
+
+        fn feed(&self, bytes: &[u8]) -> super::super::terminal::ProcessBytesResult {
+            self.pane
+                .process_pty_bytes(crate::layout::PaneId::from_raw(1), 0, bytes, &self.tx)
+        }
+
+        fn marks(&self) -> super::super::terminal::PromptMarksRead {
+            self.pane.prompt_marks(MAX_COMMANDS).unwrap()
+        }
+    }
+
+    fn command(prompt: &str, input: &str, output: &str, exit: i32) -> String {
+        format!(
+            "\x1b]133;A\x07{prompt}\x1b]133;B\x07{input}\r\n\x1b]133;C\x07{output}\x1b]133;D;{exit}\x07"
+        )
+    }
+
+    #[test]
+    fn records_rows_exit_codes_and_command_text_in_one_chunk() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        let bytes = command("$ ", "echo hi", "hi\r\n", 0)
+            + &command("$ ", "false", "", 1)
+            + "\x1b]133;A\x07$ \x1b]133;B\x07";
+        pane.feed(bytes.as_bytes());
+
+        let read = pane.marks();
+        assert_eq!(read.total_rows, 10);
+        assert_eq!(read.viewport_rows, 10);
+        assert!(!read.alternate_screen);
+        let rows: Vec<_> = read
+            .marks
+            .iter()
+            .map(|mark| {
+                (
+                    mark.prompt_row,
+                    mark.output_row,
+                    mark.end_row,
+                    mark.exit_code,
+                )
+            })
+            .collect();
+        assert_eq!(
+            rows,
+            vec![
+                (0, Some(1), Some(2), Some(0)),
+                (2, Some(3), Some(3), Some(1)),
+                (3, None, None, None),
+            ]
+        );
+        assert_eq!(read.marks[0].command.as_deref(), Some("echo hi"));
+        assert_eq!(read.marks[1].command.as_deref(), Some("false"));
+        assert_eq!(read.marks[2].command, None);
+        assert!(read.marks[0].started_at_ms.is_some());
+        assert!(read.marks[0].finished_at_ms >= read.marks[0].started_at_ms);
+    }
+
+    #[test]
+    fn prompt_start_after_partial_line_uses_the_fresh_line() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        pane.feed(b"no newline");
+        pane.feed(b"\x1b]133;A\x07$ ");
+        assert_eq!(pane.marks().marks[0].prompt_row, 1);
+    }
+
+    #[test]
+    fn rows_follow_scrollback_and_match_scroll_offsets() {
+        let pane = Pane::new(40, 5, 1_000_000);
+        let mut output = String::new();
+        for line in 0..20 {
+            output.push_str(&format!("line {line}\r\n"));
+        }
+        pane.feed(command("$ ", "seq", &output, 0).as_bytes());
+        pane.feed(b"\x1b]133;A\x07$ ");
+
+        let read = pane.marks();
+        assert_eq!(read.viewport_rows, 5);
+        assert_eq!(read.total_rows, 22);
+        assert_eq!(read.marks[0].prompt_row, 0);
+        assert_eq!(read.marks[0].output_row, Some(1));
+        assert_eq!(read.marks[0].end_row, Some(21));
+        assert_eq!(read.marks[1].prompt_row, 21);
+
+        // offset_from_bottom = total - viewport - row puts the row at the top.
+        let offset =
+            read.total_rows - read.viewport_rows - read.marks[0].output_row.unwrap() as usize;
+        pane.pane.set_scroll_offset_from_bottom(offset);
+        let metrics = pane.pane.scroll_metrics().unwrap();
+        assert_eq!(metrics.offset_from_bottom, offset);
+    }
+
+    #[test]
+    fn marks_split_across_chunks_and_prompt_redraws_are_deduplicated() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        pane.feed(b"\x1b]133;A\x07$ ");
+        // Redraw on the same row replaces the untouched prompt.
+        pane.feed(b"\r\x1b]133;A\x07$ \x1b]13");
+        pane.feed(b"3;B\x07ls\r\n\x1b]133;C\x07a b\r\n\x1b]133;D;");
+        pane.feed(b"127\x1b\\");
+        let marks = pane.marks().marks;
+        assert_eq!(marks.len(), 1);
+        assert_eq!(marks[0].prompt_row, 0);
+        assert_eq!(marks[0].exit_code, Some(127));
+        assert_eq!(marks[0].command.as_deref(), Some("ls"));
+    }
+
+    #[test]
+    fn right_prompt_cells_are_not_part_of_the_command() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        pane.feed(
+            b"\x1b]133;A\x07$ \x1b[30Grprompt\x1b[3G\x1b]133;B\x07make\r\n\x1b]133;C\x07\x1b]133;D;0\x07",
+        );
+        assert_eq!(pane.marks().marks[0].command.as_deref(), Some("make"));
+    }
+
+    #[test]
+    fn commands_whose_prompt_was_pruned_are_forgotten() {
+        let pane = Pane::new(20, 4, 1);
+        pane.feed(command("$ ", "one", "", 0).as_bytes());
+        for line in 0..20_000 {
+            pane.feed(format!("filler {line}\r\n").as_bytes());
+        }
+        pane.feed(b"\x1b]133;A\x07$ ");
+        let read = pane.marks();
+        assert_eq!(read.marks.len(), 1);
+        assert!((read.marks[0].prompt_row as usize) < read.total_rows);
+    }
+
+    #[test]
+    fn alternate_screen_marks_are_ignored() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        pane.feed(b"\x1b[?1049h\x1b]133;A\x07x\x1b[?1049l");
+        assert!(pane.marks().marks.is_empty());
+    }
+
+    #[test]
+    fn desktop_notifications_surface_osc9_and_osc777_but_not_conemu_extensions() {
+        let pane = Pane::new(40, 10, 1_000_000);
+        let result = pane.feed(
+            b"\x1b]9;build done\x07\x1b]777;notify;Title;Body text\x1b\\\x1b]9;4;1;50\x07\x1b]9;9;/tmp\x07\x07",
+        );
+        assert_eq!(
+            result.desktop_notifications,
+            vec![
+                crate::ghostty::DesktopNotification {
+                    title: None,
+                    body: "build done".into(),
+                },
+                crate::ghostty::DesktopNotification {
+                    title: Some("Title".into()),
+                    body: "Body text".into(),
+                },
+            ]
+        );
+        assert_eq!(result.terminal_bells, 1);
+        assert!(pane.feed(b"plain").desktop_notifications.is_empty());
+    }
+
+    #[test]
+    fn observe_reports_offsets_across_split_chunks() {
+        let mut tracker = PromptMarkTracker::default();
+        tracker.observe(b"x\x1b]133;A\x07$ \x1b]13");
+        assert_eq!(
+            tracker.drain_pending(),
+            vec![PromptMarkEvent {
+                end_offset: 9,
+                kind: PromptMarkKind::PromptStart
+            }]
+        );
+        tracker.observe(b"3;D;7\x1b\\");
+        assert_eq!(
+            tracker.drain_pending(),
+            vec![PromptMarkEvent {
+                end_offset: 7,
+                kind: PromptMarkKind::CommandFinished { exit_code: Some(7) }
+            }]
+        );
+    }
+}
