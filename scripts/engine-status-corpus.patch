index 07e9aa38..7052da19 100644
--- a/src/detect/manifest/tests.rs
+++ b/src/detect/manifest/tests.rs
@@ -785,3 +785,50 @@ contains = ["active"]
 "#;
     assert!(parse_manifest(manifest).is_err());
 }
+
+/// Real screens, recorded from live sessions, against the bundled rules:
+/// a regression corpus for the stuck "working", false "needs input" and
+/// missed prompts people report. Add a screen to `src/detect/corpus` and a
+/// case to its `cases.toml` whenever a status is read wrong.
+#[test]
+fn bundled_manifests_read_recorded_screens() {
+    #[derive(serde::Deserialize)]
+    struct Cases {
+        case: Vec<Case>,
+    }
+    #[derive(serde::Deserialize)]
+    struct Case {
+        screen: String,
+        agent: String,
+        expect: String,
+        note: String,
+    }
+
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src/detect/corpus");
+    let cases: Cases = toml::from_str(&std::fs::read_to_string(root.join("cases.toml")).unwrap()).unwrap();
+    assert!(!cases.case.is_empty());
+    let mut wrong = Vec::new();
+    for case in &cases.case {
+        let agent = parse_agent_label(&case.agent).unwrap_or_else(|| panic!("unknown agent {}", case.agent));
+        let screen = std::fs::read_to_string(root.join(&case.screen)).unwrap();
+        let loaded = bundled_loaded_manifest(agent, bundled_manifest(agent).unwrap(), None, None, false);
+        let explain = evaluate_loaded_manifest(
+            agent,
+            DetectionInput { screen: &screen, osc_title: "", osc_progress: "" },
+            loaded,
+            false,
+        );
+        let got = if explain.skip_state_update {
+            "skip".to_string()
+        } else {
+            format!("{:?}", explain.state).to_lowercase()
+        };
+        if got != case.expect {
+            wrong.push(format!(
+                "{} ({}): expected {}, read {} by rule {:?}",
+                case.screen, case.note, case.expect, got, explain.matched_rule
+            ));
+        }
+    }
+    assert!(wrong.is_empty(), "screens read wrong:\n{}", wrong.join("\n"));
+}
