{
  "id": "github-repos",
  "name": "GitHub Repositories",
  "version": "1.0.1",
  "description": "Typing git clone lists the repositories your GitHub CLI account can clone, most recently pushed first, and inserts the URL your git protocol setting prefers.",
  "author": "Octet",
  "octet": 1,
  "contributes": {
    "completions": [
      {
        "command": "git",
        "path": [
          "clone"
        ],
        "summary": "Copy a repository",
        "run": {
          "unix": "/bin/sh \"$OCTET_PLUGIN_DIR/list-repos.sh\"",
          "windows": "& \"$env:OCTET_PLUGIN_DIR\\list-repos.ps1\""
        },
        "kind": "repository",
        "cacheSeconds": 300,
        "timeoutSeconds": 10,
        "perFolder": false,
        "opensMenu": true,
        "prefetchWhenTyping": "git cl",
        "firstArgumentOnly": true
      }
    ]
  },
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "keywords": [
    "github",
    "git",
    "clone",
    "repositories"
  ]
}
