+/// A desktop notification a program requested with OSC 9 or OSC 777.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct DesktopNotification {
+    /// `None` when the protocol carries no title (OSC 9) or it was empty.
+    pub title: Option<String>,
+    pub body: String,
+}
+
+/// Bounds retained notifications between drains so a flood cannot grow memory.
+const MAX_PENDING_DESKTOP_NOTIFICATIONS: usize = 32;
+const MAX_DESKTOP_NOTIFICATION_BYTES: usize = 4096;
+
+unsafe extern "C" fn desktop_notification_trampoline(
+    _terminal: ffi::GhosttyTerminal,
+    userdata: *mut c_void,
+    notification: *const ffi::GhosttyTerminalDesktopNotification,
+) {
+    if userdata.is_null() || notification.is_null() {
+        return;
+    }
+    // SAFETY: size is the leading field of the live request.
+    if unsafe { (*notification).size } < mem::size_of::<ffi::GhosttyTerminalDesktopNotification>() {
+        return;
+    }
+    // SAFETY: the size check covers every field accessed below, and the strings
+    // are borrowed from libghostty-vt for the duration of this callback.
+    let request = unsafe { &*notification };
+    let (Some(title), Some(body)) = (unsafe { borrowed_bytes(request.title) }, unsafe {
+        borrowed_bytes(request.body)
+    }) else {
+        return;
+    };
+    // SAFETY: userdata is the TerminalCallbackState installed with this terminal.
+    let state = unsafe { &mut *userdata.cast::<TerminalCallbackState>() };
+    if state.desktop_notifications.len() >= MAX_PENDING_DESKTOP_NOTIFICATIONS {
+        return;
+    }
+    let text = |bytes: &[u8]| {
+        let bytes = &bytes[..bytes.len().min(MAX_DESKTOP_NOTIFICATION_BYTES)];
+        String::from_utf8_lossy(bytes)
+            .chars()
+            .filter(|ch| !ch.is_control())
+            .collect::<String>()
+    };
+    let title = text(title);
+    state.desktop_notifications.push(DesktopNotification {
+        title: (!title.is_empty()).then_some(title),
+        body: text(body),
+    });
+}
