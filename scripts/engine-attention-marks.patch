+                event: SubscriptionEventKind::PaneNotification,
+                data: SubscriptionEventData::PaneNotification(PaneNotificationEvent {
+                    pane_id,
+                    workspace_id,
+                    title,
+                    body,
+                }),
+            },
+            _ => return None,
+        };
+        let pane_id = match &envelope.data {
+            SubscriptionEventData::PaneBell(data) => &data.pane_id,
+            SubscriptionEventData::PaneNotification(data) => &data.pane_id,
