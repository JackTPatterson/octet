+use crate::api::schema::{
+    PaneMark, PaneMarksParams, ResponseResult, PANE_MARKS_DEFAULT_LIMIT, PANE_MARKS_MAX_LIMIT,
+};
+use crate::app::App;
+
+use super::responses::{encode_error, encode_success};
+
+impl App {
+    pub(super) fn handle_pane_marks(&mut self, id: String, params: PaneMarksParams) -> String {
+        let not_found = |id| {
+            encode_error(
+                id,
+                "pane_not_found",
+                format!("pane {} not found", params.pane_id),
+            )
+        };
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&params.pane_id) else {
+            return not_found(id);
+        };
+        let Some(public_pane_id) = self.public_pane_id(ws_idx, pane_id) else {
+            return not_found(id);
+        };
+        let Some(runtime) =
+            self.state
+                .runtime_for_pane_in_workspace(&self.terminal_runtimes, ws_idx, pane_id)
+        else {
+            return not_found(id);
+        };
+        let limit = params
+            .limit
+            .unwrap_or(PANE_MARKS_DEFAULT_LIMIT)
+            .min(PANE_MARKS_MAX_LIMIT);
+        let Some(read) = runtime.prompt_marks(limit as usize) else {
+            return encode_error(id, "terminal_unavailable", "pane terminal is unavailable");
+        };
+        encode_success(
+            id,
+            ResponseResult::PaneMarks {
+                pane_id: public_pane_id,
+                marks: read
+                    .marks
+                    .into_iter()
+                    .map(|mark| PaneMark {
+                        prompt_row: mark.prompt_row,
+                        output_row: mark.output_row,
+                        end_row: mark.end_row,
+                        exit_code: mark.exit_code,
+                        started_at_ms: mark.started_at_ms,
+                        finished_at_ms: mark.finished_at_ms,
+                        command: mark.command,
+                    })
+                    .collect(),
+                total_rows: read.total_rows as u64,
+                viewport_rows: read.viewport_rows as u64,
+                alternate_screen: read.alternate_screen,
+            },
+        )
+    }
+}
