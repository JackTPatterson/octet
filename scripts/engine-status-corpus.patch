@@ -0,0 +1,142 @@
+# Screens recorded from real sessions (Claude Code 2.1.283, Codex 0.153.4,
+# 2026-09-25) with the status a person would give each. Paths and names
+# are replaced; nothing else is edited. "skip" means no state change.
+# Checked by detect::manifest::tests::bundled_manifests_read_recorded_screens.
+
+[[case]]
+screen = "claude/trust-dialog.txt"
+agent = "claude"
+expect = "blocked"
+note = "first launch in a folder: the trust question"
+
+[[case]]
+screen = "claude/idle-fresh.txt"
+agent = "claude"
+expect = "idle"
+note = "a fresh session at its prompt"
+
+[[case]]
+screen = "claude/idle-draft.txt"
+agent = "claude"
+expect = "idle"
+note = "a prompt being typed, not sent"
+
+[[case]]
+screen = "claude/turn-2.txt"
+agent = "claude"
+expect = "working"
+note = "a turn running a shell command, spinner and esc to interrupt"
+
+[[case]]
+screen = "claude/turn-4.txt"
+agent = "claude"
+expect = "idle"
+note = "the turn finished: 'Sautéed for 5s · done'"
+
+[[case]]
+screen = "claude/bash-8.txt"
+agent = "claude"
+expect = "blocked"
+note = "Bash permission with four options and Tab to amend"
+
+[[case]]
+screen = "claude/approved-1.txt"
+agent = "claude"
+expect = "working"
+note = "just after approving the command"
+
+[[case]]
+screen = "claude/edit-10.txt"
+agent = "claude"
+expect = "blocked"
+note = "an edit waiting for permission, with its diff"
+
+[[case]]
+screen = "claude/declined-3.txt"
+agent = "claude"
+expect = "idle"
+note = "the edit declined with Esc"
+
+[[case]]
+screen = "claude/question-8.txt"
+agent = "claude"
+expect = "blocked"
+note = "AskUserQuestion: a multiple-choice form"
+
+[[case]]
+screen = "claude/answered.txt"
+agent = "claude"
+expect = "idle"
+note = "after answering the form"
+
+[[case]]
+screen = "claude/echoed-prompt-6.txt"
+agent = "claude"
+expect = "idle"
+note = "a reply that quotes 'Do you want to proceed? 1. Yes 2. No'"
+
+[[case]]
+screen = "claude/long-8.txt"
+agent = "claude"
+expect = "idle"
+note = "turn done with a background shell still running"
+
+[[case]]
+screen = "claude/fgrun-4.txt"
+agent = "claude"
+expect = "working"
+note = "a silent 20 s foreground command"
+
+[[case]]
+screen = "claude/streaming.txt"
+agent = "claude"
+expect = "working"
+note = "a reply streaming in"
+
+[[case]]
+screen = "claude/interrupted.txt"
+agent = "claude"
+expect = "idle"
+note = "interrupted with Esc: 'What should Claude do instead?'"
+
+[[case]]
+screen = "claude/slash-menu.txt"
+agent = "claude"
+expect = "idle"
+note = "the / command menu open at the prompt"
+
+[[case]]
+screen = "claude/draft-lookalike.txt"
+agent = "claude"
+expect = "idle"
+note = "a draft that reads like a permission prompt"
+
+[[case]]
+screen = "claude/model-picker.txt"
+agent = "claude"
+expect = "skip"
+note = "the /model picker: no state change"
+
+[[case]]
+screen = "codex/update-prompt.txt"
+agent = "codex"
+expect = "blocked"
+note = "the update offer on launch"
+
+[[case]]
+screen = "codex/trust-dialog.txt"
+agent = "codex"
+expect = "blocked"
+note = "first launch in a folder: the trust question"
+
+[[case]]
+screen = "codex/idle-fresh.txt"
+agent = "codex"
+expect = "idle"
+note = "a fresh session at its prompt, MCP warnings above"
+
+[[case]]
+screen = "codex/net-8.txt"
+agent = "codex"
+expect = "idle"
+note = "a turn refused by the usage limit"
